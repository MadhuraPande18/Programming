#include<stdio.h>

int CheckEvenOdd(int iNo)
{
    int iRem=0;
    iRem=iNo%2;
    if(iRem==0)
    {
        printf("Number is even\n");
    }

    else
    {
        printf("Number is odd\n");
    }
    
}
int main()  //program execution will start
{
    int iValue=0;
    int iRet=0;
    printf("Enter Number\n");
    scanf("%d",&iValue);
    iRet=CheckEvenOdd(iValue);

    if(iRet==0)
    {
        printf("Number is even\n");
    }

    else{
        printf("Number is odd\n");
    }
    return 0;
}
